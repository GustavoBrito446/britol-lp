---
import { Image } from 'astro:assets';
import carro from '../assets/fotos/x3-tres-quartos.jpg';
import { wa, site } from '../config/site';
import Cta from './Cta.jsx';

// Cada pacote inclui tudo do anterior: "nivel" é cumulativo.
const pacotes = [
  {
    id: 'basico', nome: 'Kit Básico', nivel: 1,
    resumo: 'Os pontos que mais sofrem no uso: onde a porta encosta, onde a unha risca, onde o pé pisa.',
    itens: ['Quinas de porta', 'Conchas de maçaneta', 'Soleiras de porta'],
  },
  {
    id: 'start', nome: 'Kit Start', nivel: 2,
    resumo: 'O Básico mais o para-choque dianteiro, a peça que leva pedra primeiro na estrada.',
    itens: ['Para-choque dianteiro'],
  },
  {
    id: 'advanced', nome: 'Advanced', nivel: 3,
    resumo: 'A frente inteira do carro protegida, mais todo o Kit Básico. É a parte que mais apanha no dia a dia.',
    itens: ['Capô', 'Paralamas'],
  },
  {
    id: 'full', nome: 'PPF Full', nivel: 4,
    resumo: 'O carro inteiro. Pintura original preservada de ponta a ponta, e a gente busca e devolve o carro na sua casa, sem custo.',
    itens: ['Carroceria completa', 'Busca e entrega grátis'],
  },
];

// Pontos na foto (% da imagem). "n" = a partir de qual pacote acende.
const pontos = [
  { n: 1, x: 85.5, y: 72.5, nome: 'Quina de porta' },
  { n: 1, x: 81, y: 68.6, nome: 'Concha de maçaneta' },
  { n: 1, x: 76, y: 82.5, nome: 'Soleira' },
  { n: 2, x: 19, y: 80, nome: 'Para-choque' },
  { n: 3, x: 36, y: 64.5, nome: 'Capô' },
  { n: 3, x: 53, y: 71, nome: 'Paralama' },
  { n: 4, x: 56, y: 56.5, nome: 'Teto e colunas' },
  { n: 4, x: 92, y: 66, nome: 'Laterais e traseira' },
  { n: 4, x: 73.5, y: 62.5, nome: 'Retrovisores' },
];
---

<section class="ppf" id="ppf" aria-labelledby="ppf-titulo">
  <div class="wrap head">
    <h2 id="ppf-titulo">PPF: escolha quanto do carro fica intocável.</h2>
    <p class="lead">
      Uma película de poliuretano transparente, em brilho ou fosco, que fica entre a pintura e o mundo.
      Pedrisco, risco do dia a dia, marca de unha: quem leva é o filme, não a sua pintura original.
      Cada pacote leva tudo do anterior e mais um pouco.
    </p>
  </div>

  <div class="wrap stage">
    <fieldset class="seletor">
      <legend class="visually-hidden">Escolha o pacote de PPF</legend>
      {pacotes.map((p, i) => (
        <label>
          <input type="radio" name="pacote" value={p.id} checked={i === 0} />
          <span class="nome">{p.nome}</span>
        </label>
      ))}
    </fieldset>

    <figure class="foto">
      <div class="quadro">
      <Image src={carro} alt="BMW X3 preta no estúdio da Britol, sob o teto de LED hexagonal" widths={[600, 900, 1300]} sizes="(min-width: 64rem) 55vw, 100vw" />
      {pontos.map((pt) => (
        <span class="ponto" data-n={pt.n} style={`--x:${pt.x}%;--y:${pt.y}%`}>
          <span class="rotulo">{pt.nome}</span>
        </span>
      ))}
      </div>
    </figure>

    <div class="detalhes">
      {pacotes.map((p) => (
        <article class="pacote" data-id={p.id}>
          <h3>{p.nome}</h3>
          <p>{p.resumo}</p>
          <ul>
            {pacotes.filter((q) => q.nivel < p.nivel).length > 0 && (
              <li class="herdado">Tudo do {pacotes[p.nivel - 2].nome}</li>
            )}
            {p.itens.map((item) => <li>{item}</li>)}
          </ul>
          {p.id === 'full' && <p class="extra">Só no Full: a gente busca o carro na sua casa, leva ao estúdio e devolve pronto. Por nossa conta.</p>}
          <p class="garantia">Garantia de {site.garantiaAnos} anos por escrito · até {site.parcelas}x no cartão</p>
          <div class="pacote-cta"><Cta client:visible href={wa(`Olá! Quero um orçamento do ${p.nome} de PPF. Meu carro é: `)} label={`Orçar o ${p.nome}`} /></div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ppf { padding-block: var(--section); border-top: 1px solid var(--line); }
  .head { display: grid; gap: 1.25rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .head h2 { max-width: 16ch; }

  .stage {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    grid-template-areas: 'seletor' 'foto' 'detalhes';
  }
  @media (min-width: 64rem) {
    .stage {
      grid-template-columns: 1.15fr 0.85fr;
      grid-template-areas: 'foto seletor' 'foto detalhes';
      grid-template-rows: auto 1fr;
      column-gap: clamp(2rem, 4vw, 4rem);
    }
  }

  /* Seletor: rádios nativos estilizados como os degraus de um painel. */
  .seletor {
    grid-area: seletor;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0; padding: 0; border: 0;
    border-bottom: 1px solid var(--line);
  }
  .seletor label { position: relative; cursor: pointer; }
  .seletor input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .seletor .nome {
    display: block;
    padding: 0.9rem 0.25rem;
    font-stretch: 112%;
    font-weight: 620;
    font-size: clamp(0.8rem, 0.7rem + 0.4vw, 1rem);
    color: var(--muted);
    text-align: center;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .seletor label:hover .nome { color: var(--ink); }
  .seletor input:checked + .nome { color: var(--gold); border-color: var(--gold); }
  .seletor input:focus-visible + .nome { outline: 2px solid var(--gold); outline-offset: 2px; }

  .foto { grid-area: foto; margin: 0; align-self: start; overflow: hidden; aspect-ratio: 1; }
  /* quadro mantém a proporção 3:4 da foto, então os pontos (em %) não desalinham;
     no celular ele sobe 1/3 para mostrar só a parte de baixo, onde está o carro */
  .quadro { position: relative; margin-top: -33.3%; }
  @media (min-width: 64rem) { .foto { aspect-ratio: auto; } .quadro { margin-top: 0; } }
  .foto img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; object-position: center 70%; filter: brightness(0.78) saturate(0.9); transition: filter 0.8s var(--ease); }

  /* Pontos: apagados até o pacote selecionado incluir aquela peça. */
  .ponto {
    position: absolute;
    left: var(--x); top: var(--y);
    width: 0.8rem; height: 0.8rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--led);
    box-shadow: 0 0 0 4px rgb(243 246 250 / 0.15), 0 0 18px 4px rgb(243 246 250 / 0.55);
    opacity: 0;
    scale: 0.4;
    transition: opacity 0.5s var(--ease), scale 0.5s var(--ease);
  }
  .rotulo {
    position: absolute;
    left: 50%; bottom: calc(100% + 0.6rem);
    translate: -50% 0;
    white-space: nowrap;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--led);
    padding: 0.15rem 0.45rem;
    background: rgb(12 11 10 / 0.8);
    border-radius: 2px;
  }
  /* linha-guia do rótulo até o ponto */
  .rotulo::after {
    content: '';
    position: absolute; left: 50%; top: 100%;
    width: 1px; height: 0.45rem;
    background: var(--led);
  }
  @media (max-width: 40rem) { .rotulo { display: none; } }

  .ppf:has(input[value='basico']:checked) .ponto[data-n='1'],
  .ppf:has(input[value='start']:checked) .ponto:is([data-n='1'], [data-n='2']),
  .ppf:has(input[value='advanced']:checked) .ponto:is([data-n='1'], [data-n='2'], [data-n='3']),
  .ppf:has(input[value='full']:checked) .ponto {
    opacity: 1;
    scale: 1;
  }
  /* No Full o carro inteiro "acende". */
  .ppf:has(input[value='full']:checked) .foto img { filter: brightness(1) saturate(1); }
  .ppf:has(input[value='full']:checked) .rotulo { display: none; }

  .detalhes { grid-area: detalhes; }
  .pacote { display: none; gap: 1rem; }
  .ppf:has(input[value='basico']:checked) .pacote[data-id='basico'],
  .ppf:has(input[value='start']:checked) .pacote[data-id='start'],
  .ppf:has(input[value='advanced']:checked) .pacote[data-id='advanced'],
  .ppf:has(input[value='full']:checked) .pacote[data-id='full'] { display: grid; }

  .pacote h3 { font-size: clamp(1.6rem, 1.3rem + 1.4vw, 2.4rem); }
  .pacote > p { color: var(--muted); max-width: 34rem; }
  .pacote ul { list-style: none; margin: 0.25rem 0 0; padding: 0; display: grid; }
  .pacote li { padding: 0.7rem 0; border-bottom: 1px solid var(--line); display: flex; gap: 0.75rem; align-items: baseline; }
  .pacote li::before { content: '+'; color: var(--gold); font-weight: 700; }
  .pacote li.herdado { color: var(--muted); }
  .pacote li.herdado::before { content: '='; color: var(--muted); }
  .pacote .extra { color: var(--ink); }
  .pacote .garantia { font-size: 0.9rem; color: var(--muted); }
  .pacote-cta { justify-self: start; margin-top: 0.5rem; }
</style>
