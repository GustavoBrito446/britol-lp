---
// Teto de LED hexagonal do estúdio, desenhado em SVG.
// Cada tubo "acende" com um pequeno flicker, como lâmpada ligando.
interface Props {
  rows?: number;
  class?: string;
}
const { rows = 3, class: className } = Astro.props;

const W = 1200;
const k = 0.36; // achata o hexágono: visto de baixo, em perspectiva
const hexes: { points: string; delay: number }[] = [];
let y = 40;
for (let row = 0; row < rows; row++) {
  const depth = 1 - row * 0.16; // fileiras do fundo ficam menores
  const r = 92 * depth;
  const stepX = r * 3.3;
  const offset = row % 2 ? stepX / 2 : 0;
  for (let x = -r + offset; x < W + r; x += stepX) {
    const h = r * 0.866 * k * 2;
    const pts = [
      [x - r, y], [x - r / 2, y - h / 2], [x + r / 2, y - h / 2],
      [x + r, y], [x + r / 2, y + h / 2], [x - r / 2, y + h / 2],
    ].map(([a, b]) => `${a.toFixed(1)},${b.toFixed(1)}`).join(' ');
    // atraso pseudoaleatório e estável (mesmo resultado em todo build)
    const delay = ((hexes.length * 37) % 11) * 0.09 + row * 0.15;
    hexes.push({ points: pts, delay });
  }
  y += 92 * depth * 0.9;
}
const H = Math.ceil(y + 10);
const glowId = `led-glow-${rows}-${Math.random().toString(36).slice(2, 7)}`; // id único se houver dois tetos na página
---

<svg class:list={['ceiling', className]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMin slice" aria-hidden="true" focusable="false">
  <defs>
    <filter id={glowId} x="-20%" y="-60%" width="140%" height="220%">
      <feGaussianBlur stdDeviation="5" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
  </defs>
  <g filter={`url(#${glowId})`}>
    {hexes.map((hx) => (
      <polygon points={hx.points} style={`--d:${hx.delay}s`} />
    ))}
  </g>
</svg>

<style>
  .ceiling { display: block; width: 100%; height: auto; overflow: visible; }
  polygon {
    fill: none;
    stroke: var(--led);
    stroke-width: 5;
    stroke-linejoin: round;
    opacity: 0;
    animation: ignite 1.1s var(--d) forwards;
  }
  @keyframes ignite {
    0% { opacity: 0; }
    10% { opacity: 0.9; }
    16% { opacity: 0.1; }
    26% { opacity: 0.75; }
    32% { opacity: 0.2; }
    100% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    polygon { animation: none; opacity: 1; }
  }
</style>
